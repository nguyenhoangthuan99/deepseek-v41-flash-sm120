# Default deny: never send host credentials, logs, checkpoint trees, or caches.
**
!Dockerfile
!.dockerignore
!versions.json
!LICENSE
!NOTICE
!licenses/
!licenses/**
!docker/
!docker/apply_pr.py
!docker/pr5121.patch
!docker/pr5121-0.6.18.patch
!docker/verify_image.py
!docker/sglang-source-manifest.json
!runtime/
!runtime/**
!sglang/
!sglang/python/
!sglang/python/**
# Keep the complete pinned Python tree, not submodule docs/tests or VCS state.
**/.git
**/.git/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/.env
**/.env.*
**/.ssh
**/.aws
**/.netrc
**/.docker/config.json
**/*.pem
**/*.key
