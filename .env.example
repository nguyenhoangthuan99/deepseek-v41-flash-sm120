# Copy to .env, edit MODEL_DIR, and explicitly export in your launch shell:
# set -a; source .env; set +a
# deploy.sh never sources this file automatically. Keep .env private.

# Required: existing complete checkpoint on host-mounted local/shared storage.
# No weights are downloaded or copied into the image. Mounted read-only at /model.
MODEL_DIR=/srv/models/DeepSeek-V4.1-Flash

IMAGE=deepseek-v41-flash-sm120:latest
BUILD_TARGET=runtime
NAME=dsv41

# No built-in authentication. Keep localhost or use an authenticated proxy.
BIND_HOST=127.0.0.1
PORT=30000
# Optional explicit endpoint for health/smoke. Leave unset to follow PORT.
# BASE_URL=http://127.0.0.1:30000

TP=8
EP=8
MOE_BACKEND=flashinfer_mxfp4
SPEC=1
DSPARK_BLOCK=3

# Configured limit, not a validated full-window request. Longest verified: 117286.
CONTEXT_LEN=1048576
MEM_FRACTION=0.80
MAX_RUNNING=32
DECODE_STEPS=4
RANDOM_SEED=599261575
NCCL_P2P_LEVEL=PHB
# Optional: NCCL_PROTO=Simple trades -24% C1 / -17% C4 for +14% C32 aggregate
# (measured, PHB PCIe). Unset keeps NCCL's automatic protocol tuner (default).
#NCCL_PROTO=Simple

# Native image: disable legacy TileLang sparse-attention override only.
DSV41_SM120_DISABLE=1
# Independently keep dense block-FP8 tuning enabled.
DSV41_SM120_FP8_DISABLE=0
STRICT=1

# Use command-scoped DRY_RUN=1 ./deploy.sh start to print, not launch.
DRY_RUN=0
